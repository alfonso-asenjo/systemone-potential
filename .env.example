# jev access. Provider: openrouter | cloudflare | typesafe
JEV_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...
# JEV_MODEL=typesafe/jev-1.13        # pin a version (default for openrouter)

# Alternative providers
# TYPESAFE_API_KEY=sk-...
# CLOUDFLARE_ACCOUNT_ID=...
# CLOUDFLARE_API_TOKEN=...

# Commander loop
DECISION_INTERVAL=1.5     # seconds between jev calls (wall clock)
CONFIDENCE_MIN=0.20       # below this confidence, keep the previous decision
DASHBOARD_PORT=8765
SWITCH_MARGIN=0.10        # a new choice must beat the current one by this probability to switch

# Map scripts (mapa/): OpenAI teacher and Wikipedia contact (Wikipedia asks for one in the User-Agent)
# OPENAI_API_KEY=
# WIKI_CONTACT=you@example.com
