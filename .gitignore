# --- Secretos: nunca se suben (.env.example lleva los nombres, sin valores)
.env

# --- Entornos y cachés
*.pyc
__pycache__/
.pytest_cache/
.venv/
.venv*/
.deepeval/

# --- Modelos (11 GB): se regeneran con los scripts de entrenamiento de cada demo
models/

# --- Registros de ejecución: llevan IPs de la red local y rutas del ordenador
logs/
mapa/logs/
pacman/logs/
**/logs-server*.txt
**/server-log.txt
**/train-log*.txt
clm/embed-log.txt

# --- Builds del comecocos (se generan con pacman/build.py y build_single.py)
pacman/dist/
pacman/dist-single/

# --- Datos del mapa de 8.131 municipios (313 MB: texto de Wikipedia, vectores, etiquetas del
# profesor). La web usa lo que ya está en mapa/static_big/; los scripts big_*.py lo regeneran.
mapa/data/

# --- Bluesky: textos de posts de otras personas. Solo se suben los resultados (report, curve-*)
# y la grabación de la casa (bluesky/static/grabacion.json, sin textos).
bluesky/data/labels.jsonl
bluesky/data/*.png
bluesky/spike/*.jsonl
bluesky/spike/review60.json

# --- Respuestas de jev con las que se entrenó a Laya en el comecocos (se regeneran con distill/dataset.py)
pacman/distill/data/train.jsonl
pacman/distill/data/test.jsonl
